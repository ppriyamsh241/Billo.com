# PostgreSQL database created on this computer
DATABASE_URL=postgresql://postgres@localhost:5432/billo

# Use a long, random value before exposing the API outside this computer.
# If omitted while developing locally, the server creates a temporary value at startup.
JWT_SECRET=

# Comma-separated browser origins permitted to call this API.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://ppriyamsh241.github.io

# The port for this API, not the PostgreSQL database port.
PORT=3000

